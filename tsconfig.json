{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "paths": {
      "@drenyra/domain": ["./packages/domain/src/index.ts"],
      "@drenyra/domain/*": ["./packages/domain/src/*"],
      "@drenyra/application": ["./packages/application/src/index.ts"],
      "@drenyra/application/*": ["./packages/application/src/*"],

      "@drenyra/ai": ["./packages/ai/src/index.ts"],
      "@drenyra/ai/provider": ["./packages/ai/src/provider.ts"],
      "@drenyra/ai/services/ai-cost": ["./packages/ai/src/services/ai-cost.ts"],
      "@drenyra/ai/services/sunat-knowledge": ["./packages/ai/src/services/sunat-knowledge.ts"],
      "@drenyra/ai/services/swarm-consensus": ["./packages/ai/src/services/swarm-consensus.ts"],
      "@drenyra/ai/services/swarm-consensus/consensus-engine": [
        "./packages/ai/src/services/swarm-consensus-engine.ts"
      ],
      "@drenyra/ai/services/swarm-consensus/types": [
        "./packages/ai/src/services/swarm-consensus-types.ts"
      ],
      "@drenyra/ai/rag/types": ["./packages/ai/src/ai/rag/types.ts"],
      "@drenyra/ai/*": ["./packages/ai/src/*"],
      "@drenyra/infrastructure": ["./packages/infrastructure/src/index.ts"],
      "@drenyra/infrastructure/*": ["./packages/infrastructure/src/*"],
      "@drenyra/persistence": ["./packages/persistence/src/index.ts"],
      "@drenyra/persistence/*": ["./packages/persistence/src/*"],
      "@drenyra/shared": ["./packages/shared/src/index.ts"],
      "@drenyra/shared/*": ["./packages/shared/src/*"],

      "@drenyra/memory": ["./packages/memory/src/index.ts"],
      "@drenyra/memory/*": ["./packages/memory/src/*"],
      "@drenyra/pi": ["../drenyra-pi/src/index.ts"],
      "@drenyra/pi/*": ["../drenyra-pi/src/*"],
      "@drenyra/test-utils": ["./packages/test-utils/src/index.ts"],
      "@drenyra/test-utils/*": ["./packages/test-utils/src/*"],
      "@drenyra/ui": ["./packages/ui/src/index.ts"],
      "@drenyra/ui/*": ["./packages/ui/src/*"],
      "@/*": ["./apps/web/src/*"],
      "@/components/*": ["./apps/web/src/components/*"],
      "@/lib/*": ["./apps/web/src/lib/*"],
      "@/hooks/*": ["./apps/web/src/hooks/*"],
      "@/context/*": ["./apps/web/src/context/*"],
      "@/store/*": ["./apps/web/src/store/*"]
    }
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/build/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/coverage/**/*",
    "**/*.d.ts",
    "**/playwright-report/**/*",
    "**/test-results/**/*",
    "**/.turbo/**/*",
    "**/.cache/**/*",
    "**/*.config.d.ts",
    "**/*.timestamp_*.js",
    "**/*.timestamp_*.d.ts"
  ],
  "references": [
    { "path": "./packages/domain" },

    { "path": "./packages/application" },
    { "path": "./packages/persistence" },
    { "path": "./packages/ai" },
    { "path": "./packages/infrastructure" },
    { "path": "./packages/shared" },
    { "path": "./packages/memory" },


    { "path": "./apps/api" },
    { "path": "./apps/web" }
  ]
}
