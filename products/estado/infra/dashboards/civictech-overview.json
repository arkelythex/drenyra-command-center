{
  "title": "CivicTech API Overview",
  "tags": ["civictech", "api", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(civictech_http_requests_total[5m]))" }
      ]
    },
    {
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(civictech_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(civictech_http_requests_total[5m]))" }
      ]
    },
    {
      "title": "Latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(civictech_http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "title": "Auth decisions",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(civictech_auth_decisions_total[5m])) by (decision, endpoint)" }
      ]
    },
    {
      "title": "Workflow transitions",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(civictech_report_transition_total[5m])) by (from_status, to_status, action)" }
      ]
    },
    {
      "title": "Workflow outcomes",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(civictech_report_workflows_completed_total[15m])) by (outcome)" }
      ]
    },
    {
      "title": "Ingest run rate",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(civictech_ingest_runs_total[30m])) by (result)" }
      ]
    },
    {
      "title": "Ingest latency p95",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(civictech_ingest_duration_seconds_bucket[30m])) by (le, result))" }
      ]
    },
    {
      "title": "Resolution latency p95",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(civictech_report_resolution_seconds_bucket[1h])) by (le, outcome))" }
      ]
    }
  ]
}
