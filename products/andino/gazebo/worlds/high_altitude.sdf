<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="andino_high_altitude">
    <physics name="default" type="ode">
      <gravity>0 0 -9.81</gravity>
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
    </physics>

    <scene>
      <ambient>0.65 0.6 0.7 1</ambient>
      <background>0.5 0.6 0.75 1</background>
      <shadows>true</shadows>
      <fog>
        <type>linear</type>
        <start>30</start>
        <end>80</end>
        <color>0.7 0.7 0.8 1</color>
      </fog>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.1 -1</direction>
    </light>

    <!-- High altitude terrain — large flat plateau -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>0.6</mu><mu2>0.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.5 0.45 0.35 1</ambient><diffuse>0.6 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mountain ridge (west side) -->
    <model name="ridge_west">
      <static>true</static>
      <pose>-30 0 10 0 0 0.2</pose>
      <link name="ridge">
        <collision name="collision">
          <geometry><box><size>20 5 20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 5 20</size></box></geometry>
          <material><ambient>0.4 0.35 0.25 1</ambient><diffuse>0.5 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mountain ridge (east side) -->
    <model name="ridge_east">
      <static>true</static>
      <pose>30 0 8 0 0 -0.15</pose>
      <link name="ridge">
        <collision name="collision">
          <geometry><box><size>15 5 16</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 5 16</size></box></geometry>
          <material><ambient>0.4 0.35 0.25 1</ambient><diffuse>0.5 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mountain peak (north) -->
    <model name="peak_north">
      <static>true</static>
      <pose>0 -25 15 0 0 0</pose>
      <link name="peak">
        <collision name="collision">
          <geometry><box><size>10 10 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 10 30</size></box></geometry>
          <material><ambient>0.55 0.5 0.4 1</ambient><diffuse>0.6 0.55 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Snow cap on peak -->
    <model name="snow_cap">
      <static>true</static>
      <pose>0 -25 28 0 0 0</pose>
      <link name="snow">
        <visual name="visual">
          <geometry><box><size>6 6 2</size></box></geometry>
          <material><ambient>0.9 0.92 0.95 1</ambient><diffuse>0.95 0.97 1.0 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Small hills for terrain variation -->
    <model name="hill_a">
      <static>true</static>
      <pose>10 10 3 0 0 0</pose>
      <link name="hill">
        <collision name="collision">
          <geometry><box><size>5 5 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 5 6</size></box></geometry>
          <material><ambient>0.45 0.4 0.3 1</ambient><diffuse>0.5 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="hill_b">
      <static>true</static>
      <pose>-12 8 2 0 0 0</pose>
      <link name="hill">
        <collision name="collision">
          <geometry><box><size>4 4 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4 4 4</size></box></geometry>
          <material><ambient>0.45 0.4 0.3 1</ambient><diffuse>0.5 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- High altitude wind (strong, gusty) -->
    <wind>
      <linear_velocity>5 3 0</linear_velocity>
    </wind>
  </world>
</sdf>
