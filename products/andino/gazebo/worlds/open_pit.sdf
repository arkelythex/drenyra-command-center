<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="andino_open_pit">
    <physics name="default" type="ode">
      <gravity>0 0 -9.81</gravity>
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- Terrain — flat ground with low friction (dust surface) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.55 0.4 1</ambient>
            <diffuse>0.7 0.65 0.5 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pit walls — ring of rectangular columns -->
    <model name="pit_ring">
      <static>true</static>
      <link name="wall_n">
        <pose>0 -15 -1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>20 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 1 3</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_s">
        <pose>0 15 -1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>20 1 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 1 3</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_e">
        <pose>15 0 -1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 20 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 20 3</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_w">
        <pose>-15 0 -1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 20 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 20 3</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
      <!-- Ramp entrance (north wall gap) -->
      <link name="ramp">
        <pose>0 -12.5 -0.5 0 0.2 0</pose>
        <collision name="collision">
          <geometry><box><size>8 4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 4 0.4</size></box></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.7 0.55 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ore deposit indicator -->
    <model name="ore_deposit">
      <static>true</static>
      <pose>5 -5 -1 0 0 0</pose>
      <link name="ore">
        <visual name="visual">
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.3 0.25 0.1 1</ambient><emissive>0.08 0.06 0.02 1</emissive></material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <!-- Survey waypoint markers (visual only) -->
    <model name="waypoint_1">
      <static>true</static>
      <pose>10 -10 0.5 0 0 0</pose>
      <link name="pole">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="waypoint_2">
      <static>true</static>
      <pose>-10 -10 0.5 0 0 0</pose>
      <link name="pole">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="waypoint_3">
      <static>true</static>
      <pose>0 10 0.5 0 0 0</pose>
      <link name="pole">
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>1</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Moderate wind for disturbance testing -->
    <wind>
      <linear_velocity>2 0.5 0</linear_velocity>
    </wind>
  </world>
</sdf>
