{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "apps/api/src/app-core.ts",
    "apps/api/src/env/**/*",
    "apps/api/src/routes/health.routes.ts",
    "apps/api/src/features/**/*",
    "apps/api/src/types/**/*",
    "apps/api/src/services/**/*",
    "apps/api/src/shared/**/*",
    "packages/domain/src/**/*",
    "packages/shared/src/**/*",
    "packages/persistence/src/client.ts",
    "packages/persistence/src/query.ts",
    "packages/persistence/src/schema/**/*",
    "packages/persistence/src/unit-of-work.ts",
    "packages/infrastructure/src/index.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.example.ts",
    "apps/api/src/app-listen.ts"
  ],
  "references": []
}
