# ARKELYTHEX Nightly AI Ops environment
# Copy to ~/.config/arkelythex/nightly-ai-ops.env and adjust locally.
# Do not commit real URLs, credentials, tokens, or customer data.

NIGHTLY_SINCE=24 hours ago
NIGHTLY_FILE_LIMIT=15
NIGHTLY_MAX_DRAFTS=8

# Optional comma-separated public/status URLs to monitor.
# Example: https://example.com,https://status.example.com
NIGHTLY_MONITOR_URLS=
