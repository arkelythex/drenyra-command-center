{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drenyra.dev/openspec/coordination/ledger.schema.json",
  "title": "Drenyra Ecosystem Audit Readiness — Umbrella Ledger Contract",
  "description": "Canonical fail-closed JSON Schema for the umbrella coordination ledger (coordination/ledger.yaml). It defines the machine-readable contract only: it does not assert that any child, including C1 (H02), is executable — executability is derived by the resolver from recorded lifecycle and evidence. Unknown fields, unknown schema versions, and structurally invalid records fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "ledger_revision",
    "policy",
    "repositories",
    "children",
    "evidence",
    "research",
    "exceptions",
    "events",
    "program_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Version-gated contract version; unknown versions are rejected. Semantic changes require a new version and a migration record."
    },
    "program_id": {
      "type": "string",
      "const": "drenyra-ecosystem-audit-readiness",
      "description": "Immutable identifier of this umbrella program."
    },
    "ledger_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic revision; every accepted mutation advances it and appends an event. Stale concurrent writes fail."
    },
    "policy": { "$ref": "#/$defs/policy" },
    "repositories": { "$ref": "#/$defs/repositoryMap" },
    "children": { "$ref": "#/$defs/childrenMap" },
    "evidence": { "$ref": "#/$defs/evidenceMap" },
    "research": { "$ref": "#/$defs/researchMap" },
    "exceptions": { "$ref": "#/$defs/exceptionsMap" },
    "events": { "$ref": "#/$defs/events" },
    "program_status": { "$ref": "#/$defs/programStatus" }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_owner",
        "effective_unit_limit",
        "config_default_unit_limit",
        "chain_strategy"
      ],
      "properties": {
        "program_owner": {
          "type": "string",
          "minLength": 1,
          "description": "Drenyra program owner; accountable authority for the ledger and size-gate exceptions."
        },
        "effective_unit_limit": {
          "const": 300,
          "description": "Program override: 300 changed lines per unit, stricter than the repository convention."
        },
        "config_default_unit_limit": {
          "const": 400,
          "description": "Repository convention persisted in openspec/config.yaml; the program applies the stricter 300."
        },
        "chain_strategy": {
          "enum": ["feature-branch-chain", "stacked-to-main"],
          "description": "Delivery chain strategy for oversized program work."
        },
        "exceptions_allowed": {
          "type": "boolean",
          "description": "When true, explicit program-owner exceptions may waive only the size gate."
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "authority_kind", "allowed_child_prefix"],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical repository identity."
        },
        "authority_kind": {
          "enum": ["umbrella-owner", "sibling"],
          "description": "umbrella-owner: Drenyra; sibling: never written from this change."
        },
        "allowed_child_prefix": {
          "type": "string",
          "minLength": 1,
          "description": "Allowed child-artifact path prefix in this repository."
        }
      }
    },
    "repositoryMap": {
      "type": "object",
      "propertyNames": { "enum": ["drenyra", "drenyra-pi", "drenyra-ai", "drenyra-engram"] },
      "additionalProperties": { "$ref": "#/$defs/repository" }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "authority_mode",
        "change_id",
        "state_path",
        "revision",
        "observed_phase",
        "observed_status",
        "program_state",
        "blockers",
        "mandatory",
        "conditional"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Exactly one owning repository (a key of repositories; a single string, never an array)."
        },
        "authority_mode": {
          "enum": ["existing", "new-local", "external-reference"],
          "description": "C1 is permanently 'existing' (resumes drenyra-h02-tenant-isolation)."
        },
        "change_id": {
          "type": "string",
          "minLength": 1,
          "description": "Child change identifier in its owning repository (C1 must remain drenyra-h02-tenant-isolation)."
        },
        "state_path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative state path; absolute paths, worktree paths, and ambient branches are invalid."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable revision of the referenced authority."
        },
        "observed_phase": {
          "type": "string",
          "minLength": 1,
          "description": "Observed lifecycle phase reported by the owning repository (e.g. tasks)."
        },
        "observed_status": {
          "type": "string",
          "minLength": 1,
          "description": "Observed lifecycle status (e.g. review-pending); unknown states fail closed at resolution."
        },
        "program_state": {
          "enum": [
            "declared",
            "planning",
            "blocked",
            "eligible",
            "executable",
            "executing",
            "verified",
            "delivered",
            "closed",
            "rolled-back",
            "superseded",
            "not-required"
          ],
          "description": "Typed derived program state; never inferred from observation alone."
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AUTHORITY_MISSING",
              "LIFECYCLE_NOT_EXECUTABLE",
              "H02_REVIEW_PENDING",
              "DEPENDENCY_UNSATISFIED",
              "EVIDENCE_MISSING",
              "EVIDENCE_STALE",
              "EVIDENCE_CONTRADICTORY",
              "FORECAST_MISSING",
              "LINE_LIMIT_EXCEEDED",
              "EXCEPTION_MISSING",
              "QUALITY_GATE_FAILED",
              "REVIEW_NOT_APPROVED",
              "DELIVERY_NOT_PROVEN",
              "C7_TRIGGER_INCOMPLETE",
              "ROLLBACK_INVALIDATED_DEPENDENCY"
            ]
          },
          "description": "Typed blockers; a blocked child must name at least one."
        },
        "mandatory": { "type": "boolean", "description": "C1–C6 are mandatory; C7 is not." },
        "conditional": {
          "type": "boolean",
          "description": "Only C7 is conditional (closed by default)."
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^C[1-7]$" },
          "description": "Hard dependency child IDs (e.g. C2 depends on C1)."
        },
        "units": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Bounded delivery units (e.g. W0–W6 for C1)."
        },
        "acceptance_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Acceptance criteria/evidence references."
        },
        "last_event_id": {
          "type": "string",
          "description": "ID of the last event affecting this child."
        }
      }
    },
    "childrenMap": {
      "type": "object",
      "propertyNames": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
      "additionalProperties": { "$ref": "#/$defs/child" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "child", "owner", "authority_path", "revision", "result", "timestamp"],
      "properties": {
        "kind": {
          "enum": [
            "lifecycle",
            "dependency",
            "forecast",
            "verification",
            "review",
            "delivery",
            "release",
            "rollback",
            "blocker"
          ],
          "description": "Typed evidence kind."
        },
        "child": { "type": "string", "pattern": "^C[1-7]$" },
        "unit": { "type": "string", "description": "Bounded unit/PR identifier (optional)." },
        "owner": { "type": "string", "minLength": 1, "description": "Owning repository key." },
        "authority_path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative authority path (path containment enforced)."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable revision; mutable identity cannot advance state."
        },
        "subject_identity": {
          "type": "string",
          "description": "Digest, receipt, or release identity (optional)."
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 timestamp of the evidence."
        },
        "collector_role": {
          "type": "string",
          "description": "Role that collected the evidence (optional)."
        },
        "result": {
          "enum": ["passed", "failed", "blocked", "unresolved"],
          "description": "Typed outcome; bare green/ready/compatible labels are invalid evidence."
        },
        "check_result": { "type": "string", "description": "Bounded check result (optional)." },
        "test_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "total"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          },
          "description": "Useful test counts (optional)."
        },
        "acceptance_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Acceptance-criterion mapping (optional)."
        }
      }
    },
    "evidenceMap": {
      "type": "object",
      "propertyNames": { "pattern": "^evt-[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/evidence" }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child", "uncertainty", "publisher", "retrieved_at", "decision_effect"],
      "properties": {
        "child": { "type": "string", "pattern": "^C[1-7]$" },
        "uncertainty": {
          "type": "string",
          "minLength": 1,
          "description": "Exact time-sensitive uncertainty resolved."
        },
        "relevance_confirmed": {
          "type": "boolean",
          "description": "Child confirmed relevance before retrieval (optional)."
        },
        "primary_source_url": {
          "type": "string",
          "minLength": 1,
          "description": "Authoritative primary source URL; absent means unresolved risk, never a factual claim."
        },
        "publisher": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "description": "Source title (optional)." },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "description": "Retrieval date; source facts are time-bound."
        },
        "source_version": {
          "type": "string",
          "description": "Source version/date when available (optional)."
        },
        "content_digest": {
          "type": "string",
          "description": "Content digest when lawful (optional)."
        },
        "affected_requirement": {
          "type": "string",
          "description": "Requirement or design decision affected (optional)."
        },
        "decision_effect": {
          "enum": ["confirmed", "changed", "unresolved"],
          "description": "Whether the source confirmed, changed, or left the decision unresolved; unresolved never advances a gate."
        }
      }
    },
    "researchMap": {
      "type": "object",
      "propertyNames": { "pattern": "^r-[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/research" }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child",
        "unit",
        "scope_digest",
        "proposed_ceiling",
        "rationale",
        "approval",
        "ledger_revision",
        "expires_at"
      ],
      "properties": {
        "child": { "type": "string", "pattern": "^C[1-7]$" },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Exact bounded unit the exception covers."
        },
        "scope_digest": {
          "type": "string",
          "minLength": 1,
          "description": "Scope digest; a scope change invalidates the exception."
        },
        "proposed_ceiling": {
          "type": "integer",
          "minimum": 301,
          "description": "Proposed line ceiling above 300."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Recorded-before-apply rationale."
        },
        "alternatives": { "type": "string", "description": "Alternatives considered (optional)." },
        "reviewer_impact_mitigation": {
          "type": "string",
          "description": "Reviewer-impact mitigation (optional)."
        },
        "rollback_boundary": {
          "type": "string",
          "description": "Rollback boundary for the unit (optional)."
        },
        "requester": { "type": "string", "description": "Requester identity (optional)." },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "approver", "approved_at"],
          "properties": {
            "approved": { "type": "boolean" },
            "approver": { "type": "string", "minLength": 1 },
            "approved_at": { "type": "string", "minLength": 1 }
          },
          "description": "Explicit Drenyra program-owner approval; waives only the size gate."
        },
        "ledger_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Ledger revision at approval time."
        },
        "expires_at": {
          "type": "string",
          "minLength": 1,
          "description": "Expiry; an expired exception is invalid."
        }
      }
    },
    "exceptionsMap": {
      "type": "object",
      "propertyNames": { "pattern": "^x-[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/exception" }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "revision",
        "timestamp",
        "prior_state",
        "new_state",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Append-only event ID; duplicates are rejected."
        },
        "kind": {
          "enum": [
            "program-initialized",
            "child-handoff-requested",
            "decision",
            "transition",
            "import",
            "migration",
            "rollback",
            "pause",
            "exception",
            "rejection"
          ],
          "description": "Typed event kind."
        },
        "child": {
          "type": "string",
          "pattern": "^C[1-7]$",
          "description": "Affected child, when the event is child-scoped (optional)."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Ledger revision of the event (monotonic)."
        },
        "timestamp": { "type": "string", "minLength": 1 },
        "prior_state": {
          "type": "string",
          "minLength": 1,
          "description": "Prior state (child program state or ledger-level label)."
        },
        "new_state": {
          "type": "string",
          "minLength": 1,
          "description": "New state after the event."
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence record references backing the event."
        },
        "reason": { "type": "string", "description": "Optional reason (e.g. rollback cause)." }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" },
      "minItems": 1,
      "description": "Append-only event log; history is never deleted."
    },
    "programStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "derived_at",
        "readiness_scope",
        "ecosystem_ready",
        "next_safe_action"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Ledger revision this status was derived from."
        },
        "derived_at": {
          "type": "string",
          "minLength": 1,
          "description": "Timestamp of derivation."
        },
        "readiness_scope": {
          "type": "string",
          "minLength": 1,
          "description": "Capability-scoped readiness description; never ecosystem-wide while C1–C6 are open."
        },
        "ecosystem_ready": {
          "type": "boolean",
          "description": "Must be false until C1–C6 are closed and C7 is closed-after-valid-opening or not-required; the schema asserts no readiness — the resolver derives it."
        },
        "next_safe_action": {
          "type": "string",
          "minLength": 1,
          "description": "Least-advanced safe next action (e.g. resume H02 review)."
        },
        "children_derived": {
          "type": "object",
          "propertyNames": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
          "additionalProperties": {
            "enum": [
              "declared",
              "planning",
              "blocked",
              "eligible",
              "executable",
              "executing",
              "verified",
              "delivered",
              "closed",
              "rolled-back",
              "superseded",
              "not-required"
            ]
          },
          "description": "Optional per-child derived states."
        }
      }
    }
  }
}
