# =============================================================================
# ARKELYTHEX — Canonical Environment Variables Reference
# =============================================================================
# This is the SINGLE authoritative source of truth for all env vars.
# App-specific .env.example files reference this file for shared vars.
#
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development                     # development | production | test
PORT=3000                                # API server port
LOG_LEVEL=debug                          # debug | info | warn | error
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=127.0.0.1,::1            # Comma-separated trusted proxy IPs

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/arkelythex
# Neon Postgres (ADR-023):
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
DB_USER=user
DB_PASSWORD=password
DB_NAME=arkelythex
DB_PORT=5436

# ── Redis / Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change_me_min_32_chars  # Generate: openssl rand -base64 32
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.18.4:5173,http://10.0.0.20:4173

# ── JWT ──────────────────────────────────────────────────────────────────────
# JWT_SECRET=change_me_min_32_chars
# JWT_EXPIRES_IN=7d

# ── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=
AI_MODEL=gpt-4o

# ── SUNAT / Fiscal ──────────────────────────────────────────────────────────
SUNAT_API_URL=https://api.sunat.gob.pe
SUNAT_API_TIMEOUT_MS=4500
SUNAT_RUC=20123456789                      # 11-digit RUC
SUNAT_CPE_VALIDATION_MODE=sandbox          # sandbox | replay | real
SUNAT_CPE_API_TOKEN=                       # Clave SOL / beta credentials
OSE_PROVIDER=simulation                    # nubefact | bizlinks | custom | simulation
OSE_ENV=sandbox                            # sandbox | production
OSE_API_URL=
OSE_API_TOKEN=
# SIRE bearer token secret (falls back to BETTER_AUTH_SECRET if omitted)
SIRE_JWT_SECRET=change_me_min_32_chars
SIRE_RATE_LIMIT_MAX_REQUESTS=10
SIRE_RATE_LIMIT_WINDOW_MINUTES=1

# ── SMTP / Email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here           # Gmail: Generate app password
SMTP_FROM_NAME=ARKELYTHEX
SMTP_FROM_EMAIL=noreply@arkelythexfounders.com

# ── Storage (S3-compatible) ──────────────────────────────────────────────────
STORAGE_PROVIDER=r2                        # r2 | minio | s3
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=arkelythex-documents

# ── Prometeo Banking API ─────────────────────────────────────────────────────
PROMETEO_API_KEY=
PROMETEO_ENV=sandbox

# ── Error Tracking ───────────────────────────────────────────────────────────
# SENTRY_DSN=

# ── Frontend Telemetry ───────────────────────────────────────────────────────
FRONTEND_MONITORING_KEY=
FRONTEND_MONITORING_REQUIRE_KEY=           # Default: true in production
FRONTEND_TELEMETRY_DB_ENABLED=true

# ── LEDGER MVP (SIRE Autopilot / NPIF baseline / Monitor Fiscal) ──────────
# LEDGER_MVP_ENABLED=true
# LEDGER_MVP_REQUIRE_AUTH=true
# LEDGER_MVP_ALLOWED_COMPANY_IDS=
# LEDGER_MVP_ALLOWED_ROLES=
# LEDGER_MVP_ALLOWED_ROLES_SIRE_AUTOPILOT=
# LEDGER_MVP_ALLOWED_ROLES_NPIF_BASIC=
# LEDGER_MVP_ALLOWED_ROLES_MONITOR_FISCAL=
# LEDGER_MVP_BLOCKING_RECORD_GAP=25
# LEDGER_MVP_BLOCKING_IGV_GAP_PEN=250
# LEDGER_MVP_BLOCKING_TOTAL_GAP_PEN=2000
# LEDGER_MVP_BLOCKING_SUNAT_RECORD_GAP=10
# LEDGER_MVP_BLOCKING_SUNAT_IGV_GAP_PEN=500
# LEDGER_MVP_BLOCKING_SUNAT_TOTAL_GAP_PEN=3000

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AI_AGENTS=true
ENABLE_SUNAT_SYNC=false

# ── Telemetry / Ops ──────────────────────────────────────────────────────────
ARKELYTHEX_ENABLE_OTEL=false
OTEL_SERVICE_NAME=arkelythex-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
ARKELYTHEX_BACKUP_DIR=backups/postgres

# ── Data Engine ──────────────────────────────────────────────────────────────
DATA_ENGINE_PORT=8000
DATA_ENGINE_URL=http://localhost:8000
POLARS_MAX_THREADS=8
MAX_UPLOAD_SIZE_MB=50
CASHFLOW_FORECAST_DAYS=90

# ── Landing ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://arkelythex.com
NEXT_PUBLIC_CONTACT_EMAIL=arkelythexfounders@gmail.com
NEXT_PUBLIC_LEGAL_EMAIL=arkelythexfounders@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=51926437404
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_TO_EMAIL=arkelythexfounders@gmail.com

# ── Web Frontend ─────────────────────────────────────────────────────────────
VITE_BETTER_AUTH_URL=http://localhost:5173
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_ENABLE_DEMO_AUTH=false
VITE_HTTP_TIMEOUT_MS=10000
VITE_FRONTEND_MOCK_MODE=false
VITE_MONITORING_ENABLED=true
VITE_MONITORING_ENDPOINT=
VITE_MONITORING_KEY=
VITE_WEB_VITALS_ENABLED=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_API_HOST=https://plausible.io
VITE_ENABLE_VOICE_NAVIGATION=true

# ── MinIO (local S3) ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=arkelythex-documents

# ── Ollama (optional local AI) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Never commit .env files to git
# 2. Use strong random values for secrets in production
# 3. VITE_ prefixed vars are exposed to ALL frontend users via JS bundle
# 4. Database must be PostgreSQL 15+ with pgvector
