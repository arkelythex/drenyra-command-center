      "input": [
        { "id": "ev_3", "label": "Bank statement", "type": "document" },
        { "id": "ev_1", "label": "Invoice", "type": "document" },
        { "id": "ev_2", "label": "Receipt", "type": "document" }
      ],
      "expectedSha256": "625aaf49f6b926e9eadd739fa0a7ec9bad2befe9193a0ead4f16f8f2505300d8"
