        "missionId": "mis_empty",
        "timestamp": "2026-01-01T00:00:00Z"
      },
      "expectedCanonicalJson": "{\"missionId\":\"mis_empty\",\"timestamp\":\"2026-01-01T00:00:00Z\"}",
      "expectedSha256": "209bc1f17c41982559b250edd6a96563ec7246163c125f57122da76427766d47"
