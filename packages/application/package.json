{
  "name": "@drenyra/application",
  "version": "1.0.0",
  "description": "Application layer - use cases, DTOs, and ports",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dtos/*": "./src/dtos/*.ts",
    "./ports/*": "./src/ports/*.ts",
    "./fiscal-truth": "./src/fiscal-truth/index.ts",
    "./drenyra": "./src/drenyra/index.ts",
    "./services/*": "./src/services/*.ts",
    "./use-cases/*": "./src/use-cases/*.ts",
    "./validators/*": "./src/validators/*.ts",
    "./features/evidence": "./src/features/evidence/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@drenyra/domain": "workspace:*",
    "@drenyra/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
