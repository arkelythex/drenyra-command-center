{
  "name": "@drenyra/application",
  "version": "1.0.0",
  "description": "Application layer - use cases, DTOs, and ports",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dtos/*": "./src/dtos/*.ts",
    "./ports/*": "./src/ports/*.ts",
    "./fiscal-truth": "./src/fiscal-truth/index.ts",
    "./drenyra": "./src/drenyra/index.ts",
    "./services/*": "./src/services/*.ts",
    "./use-cases/*": "./src/use-cases/*.ts",
    "./validators/*": "./src/validators/*.ts",
    "./features/accounting-prs": "./src/features/accounting-prs/index.ts",
    "./features/evidence": "./src/features/evidence/index.ts",
    "./features/banking": "./src/features/banking/index.ts",
    "./features/billing": "./src/features/billing/index.ts",
    "./features/auth": "./src/features/auth/index.ts",
    "./features/api-marketplace": "./src/features/api-marketplace/index.ts",
    "./features/automation-studio": "./src/features/automation-studio/index.ts",
    "./features/cfo-analytics": "./src/features/cfo-analytics/index.ts",
    "./features/client-comms": "./src/features/client-comms/index.ts",
    "./features/doctor-mode": "./src/features/doctor-mode/index.ts",
    "./features/judgment-day": "./src/features/judgment-day/index.ts",
    "./features/monthly-close": "./src/features/monthly-close/index.ts",
    "./features/rag-enterprise": "./src/features/rag-enterprise/index.ts",
    "./features/sire-comparison": "./src/features/sire-comparison/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@drenyra/domain": "workspace:*",
    "@drenyra/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
