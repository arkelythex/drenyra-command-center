{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fiscal Lens Result",
  "description": "Result of running a fiscal accounting review lens",
  "type": "object",
  "properties": {
    "lens": {
      "type": "string",
      "enum": ["ledger-integrity", "sunat-compliance", "audit-trail", "tenant-isolation"]
    },
    "ruc": { "type": "string", "pattern": "^[0-9]{11}$" },
    "periodo": { "type": "string", "pattern": "^[0-9]{6}$" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error", "critical"] },
          "description": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["id", "severity", "description"]
      }
    },
    "summary": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["lens", "ruc", "periodo", "status", "findings", "summary"]
}
