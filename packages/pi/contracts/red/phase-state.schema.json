{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSD Phase State",
  "description": "Full state of a fiscal period in the FSD lifecycle",
  "type": "object",
  "properties": {
    "ruc": { "type": "string", "pattern": "^[0-9]{11}$" },
    "periodo": { "type": "string", "pattern": "^[0-9]{6}$" },
    "currentPhase": {
      "type": "string",
      "enum": ["captura", "clasificacion", "conciliacion", "cierre", "declaracion", "auditoria"]
    },
    "status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "completed", "blocked", "failed"]
    },
    "riskTier": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
    "receipts": {
      "type": "array",
      "items": { "$ref": "./receipt.schema.json" }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "enum": ["captura", "clasificacion", "conciliacion", "cierre", "declaracion", "auditoria"] },
          "label": { "type": "string" },
          "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "blocked", "failed"] }
        },
        "required": ["id", "label", "status"]
      }
    },
    "proposal": { "type": "object" },
    "spec": { "type": "object" },
    "design": { "type": "object" },
    "personaDisabled": { "type": "boolean" }
  },
  "required": ["ruc", "periodo", "currentPhase", "status", "riskTier", "phases"]
}
