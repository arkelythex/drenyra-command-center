{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fiscal Phase State",
  "description": "State schema for the FSD (Fiscal Spec-Driven Execution) lifecycle",
  "type": "object",
  "properties": {
    "ruc": { "type": "string", "pattern": "^[0-9]{11}$" },
    "periodo": { "type": "string", "pattern": "^[0-9]{6}$" },
    "currentPhase": {
      "type": "string",
      "enum": [
        "captura",
        "clasificacion",
        "conciliacion",
        "cierre",
        "declaracion",
        "auditoria"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked",
        "failed"
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "captura",
              "clasificacion",
              "conciliacion",
              "cierre",
              "declaracion",
              "auditoria"
            ]
          },
          "label": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "completed",
              "blocked",
              "failed"
            ]
          }
        },
        "required": ["id", "label", "status"]
      },
      "minItems": 6,
      "maxItems": 6
    }
  },
  "required": ["ruc", "periodo", "currentPhase", "status", "phases"]
}
