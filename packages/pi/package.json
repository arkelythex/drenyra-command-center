{
  "name": "@drenyra/pi",
  "version": "1.0.0-alpha.1",
  "description": "Drenyra Pi — Agent harness for Peruvian fiscal intelligence. SDK for building fiscal AI agents with SDD, memory, and compliance pipelines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./serve": "./dist/serve.js",
    "./strategies": "./dist/strategies/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "bun src/serve.ts",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "drenyra",
    "fiscal",
    "peru",
    "sunat",
    "sdd",
    "ai-agents",
    "pi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkelythex/Drenyra.git"
  },
  "bugs": {
    "url": "https://github.com/arkelythex/Drenyra/issues"
  },
  "homepage": "https://github.com/arkelythex/Drenyra#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.7",
    "@mastra/core": "^1.4.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "ai": "^6.0.39",
    "hono": "^4.12.27",
    "yaml": "^2.9.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
