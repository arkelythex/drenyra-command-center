{
  "name": "@drenyra/pi",
  "version": "1.0.0-alpha.1",
  "description": "Drenyra Pi \u2014 Agent harness for Peruvian fiscal intelligence. SDK for building fiscal AI agents with SDD, memory, and compliance pipelines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "extensions",
    "prompts",
    "skills",
    "contracts",
    "themes",
    "scripts",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./serve": "./dist/serve.js",
    "./strategies": "./dist/strategies/index.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "bun src/serve.ts",
    "hooks:install": "bash scripts/install-hooks.sh",
    "test:watch": "vitest",
    "prepublishOnly": "echo 'Private package \u2014 not published to npm'; exit 1"
  },
  "keywords": [
    "drenyra",
    "fiscal",
    "peru",
    "sunat",
    "sdd",
    "ai-agents",
    "pi",
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkelythex/drenyra-command-center.git"
  },
  "bugs": {
    "url": "https://github.com/arkelythex/drenyra-command-center/issues"
  },
  "homepage": "https://github.com/arkelythex/drenyra-command-center#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.7",
    "@mastra/core": "^1.4.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "ai": "^6.0.39",
    "hono": "^4.12.27",
    "yaml": "^2.9.0",
    "zod": "^4.3.5",
    "drenyra-ai": "file:../../vendored/drenyra-ai-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
