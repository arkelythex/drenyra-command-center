{
  "name": "@drenyra/platform-core",
  "version": "0.1.0",
  "description": "Drenyra Platform runtime \u2014 agents, AI gateway, memory, harness and plugin system",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/env-schema": "./src/config/env-schema.ts",
    "./config/logger": "./src/config/logger.ts",
    "./config/rate-limit": "./src/config/rate-limit.ts",
    "./kernel": "./src/kernel/types.ts",
    "./kernel/errors": "./src/kernel/errors.ts",
    "./kernel/lifecycle": "./src/kernel/lifecycle.ts",
    "./kernel/event-bus": "./src/kernel/event-bus.ts",
    "./swarm": "./src/swarm/types.ts",
    "./swarm/orchestrator": "./src/swarm/orchestrator.ts",
    "./swarm/worker-pool": "./src/swarm/worker-pool.ts",
    "./swarm/router": "./src/swarm/router.ts",
    "./ai-gateway": "./src/ai-gateway/types.ts",
    "./ai-gateway/provider": "./src/ai-gateway/provider.ts",
    "./ai-gateway/registry": "./src/ai-gateway/registry.ts",
    "./ai-gateway/tool-bridge": "./src/ai-gateway/tool-bridge.ts",
    "./ai-gateway/gateway": "./src/ai-gateway/gateway.ts",
    "./memory": "./src/memory/types.ts",
    "./harness": "./src/harness/index.ts",
    "./plugin": "./src/plugin/interface.ts",
    "./plugin/fiscal-plugin": "./src/plugin/fiscal-plugin.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drenyra/platform-core.git"
  },
  "keywords": [
    "agent",
    "orchestration",
    "multi-agent",
    "swarm",
    "ai",
    "llm",
    "plugin",
    "agentic"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "zod": "^4.3.5",
    "pino": "^10.3.1",
    "elysia": "1.4.28"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
