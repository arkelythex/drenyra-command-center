{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/weld-record.schema.json",
  "title": "Weld Record",
  "description": "A single weld bead or pass. Un cordon o pase individual de soldadura.",
  "type": "object",
  "required": ["beadId", "process", "electrode", "amperage", "polarity"],
  "properties": {
    "beadId": {
      "type": "string",
      "description": "Unique bead identifier within the session.",
      "pattern": "^bd-[0-9a-f]{6}$"
    },
    "passNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "Pass number in multi-pass welds."
    },
    "process": {
      "type": "string",
      "enum": ["SMAW", "GMAW", "GTAW", "FCAW", "SAW"]
    },
    "electrode": {
      "type": "object",
      "description": "Electrode or filler wire. Electrodo o alambre de aporte.",
      "required": ["classification", "diameterMm"],
      "properties": {
        "classification": {
          "type": "string",
          "description": "e.g., E6013, ER70S-6"
        },
        "diameterMm": { "type": "number", "minimum": 0.5 },
        "brand": { "type": "string" },
        "storageCondition": {
          "type": "string",
          "enum": ["sealed", "open", "reconditioned", "unknown"]
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Machine settings. Configuracion de la maquina.",
      "properties": {
        "amperage": {
          "type": "number",
          "description": "Welding current in amperes (A)"
        },
        "voltage": {
          "type": "number",
          "description": "Arc voltage in volts (V)"
        },
        "wireFeedSpeed": {
          "type": "number",
          "description": "Wire feed speed in m/min (GMAW/FCAW)"
        },
        "travelSpeed": {
          "type": "number",
          "description": "Travel speed in mm/min"
        },
        "polarity": {
          "type": "string",
          "enum": ["DCEN", "DCEP", "AC"],
          "description": "DCEN (straight), DCEP (reverse), AC"
        }
      }
    },
    "shieldingGas": {
      "type": "object",
      "description": "Shielding gas for GMAW/GTAW/FCAW. Gas de proteccion.",
      "properties": {
        "composition": {
          "type": "string",
          "description": "e.g., 75% Ar / 25% CO2"
        },
        "flowRate": { "type": "number", "description": "Flow rate in L/min" }
      }
    },
    "jointPreparation": {
      "type": "string",
      "description": "Joint preparation, e.g., single-V, bevel, square."
    },
    "result": {
      "type": "object",
      "description": "Visual evaluation of the completed bead. Evaluacion visual del cordon terminado.",
      "properties": {
        "visualQuality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=very poor, 3=acceptable, 5=excellent"
        },
        "defects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "undercut",
              "porosity",
              "spatter",
              "lackOfFusion",
              "excessiveConvexity",
              "crater",
              "crack",
              "slagInclusion",
              "other"
            ]
          }
        },
        "notes": { "type": "string" }
      }
    },
    "photos": {
      "type": "array",
      "description": "References to photos. Referencias a fotografias.",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["bead_face", "bead_profile", "root", "setup", "other"]
          },
          "caption": { "type": "string" }
        }
      }
    },
    "comments": {
      "type": "string",
      "description": "Personal observations. Observaciones personales sobre el cordon."
    }
  }
}
