{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/inspection-record.schema.json",
  "title": "Inspection Record",
  "description": "Visual inspection observation for a weld. Observacion de inspeccion visual de una soldadura.",
  "type": "object",
  "required": ["inspectionId", "beadRef", "date", "inspector", "defects"],
  "properties": {
    "inspectionId": {
      "type": "string",
      "description": "Unique inspection identifier.",
      "pattern": "^ins-[0-9a-f]{8}$"
    },
    "beadRef": {
      "type": "string",
      "description": "Reference to the inspected weld bead ID."
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "inspector": {
      "type": "object",
      "required": ["alias"],
      "properties": {
        "alias": { "type": "string" },
        "certification": { "type": "string", "description": "e.g., CWI, None" }
      }
    },
    "method": {
      "type": "string",
      "enum": [
        "visual",
        "visual_aided",
        "penetrant",
        "magnetic",
        "ultrasonic",
        "radiographic",
        "other"
      ],
      "description": "Inspection method used."
    },
    "defects": {
      "type": "array",
      "description": "Defects observed. Defectos observados.",
      "items": {
        "type": "object",
        "required": ["type", "severity", "location"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "undercut",
              "porosity",
              "spatter",
              "lackOfFusion",
              "excessiveConvexity",
              "excessiveReinforcement",
              "insufficientThroat",
              "crater",
              "crack",
              "slagInclusion",
              "discontinuity",
              "misalignment",
              "distortion",
              "other"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["minor", "moderate", "severe", "critical"]
          },
          "location": {
            "type": "string",
            "description": "Position on the bead: start, middle, end, root, face, toe."
          },
          "dimensionsMm": {
            "type": "object",
            "properties": {
              "length": { "type": "number" },
              "depth": { "type": "number" },
              "width": { "type": "number" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "overallAssessment": {
      "type": "string",
      "enum": ["acceptable", "needsRepair", "rejected", "referForTesting"],
      "description": "Overall visual assessment. Evaluacion visual general."
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "defectHighlight": { "type": "string" }
        }
      }
    },
    "disclaimer": {
      "type": "boolean",
      "const": true,
      "description": "Must be true. This inspection is indicative and does not substitute professional testing. Debe ser true. Esta inspeccion es orientativa y no sustituye ensayos profesionales."
    },
    "notes": { "type": "string" }
  }
}
