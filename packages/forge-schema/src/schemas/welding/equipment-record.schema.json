{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeos.dev/schemas/equipment-record.schema.json",
  "title": "Equipment Record",
  "description": "Welding machine and equipment used. Maquina y equipos de soldadura utilizados.",
  "type": "object",
  "required": ["equipmentId", "make", "model", "type"],
  "properties": {
    "equipmentId": {
      "type": "string",
      "description": "Unique equipment identifier.",
      "pattern": "^eq-[0-9a-f]{6}$"
    },
    "make": {
      "type": "string",
      "description": "Manufacturer. Fabricante."
    },
    "model": {
      "type": "string",
      "description": "Model number or name."
    },
    "type": {
      "type": "string",
      "enum": [
        "transformer",
        "rectifier",
        "inverter",
        "engineDriven",
        "multiProcess"
      ],
      "description": "Machine technology type."
    },
    "processes": {
      "type": "array",
      "description": "Processes this machine supports.",
      "items": {
        "type": "string",
        "enum": ["SMAW", "GMAW", "GTAW", "FCAW", "SAW", "cutter"]
      }
    },
    "serialNumber": {
      "type": "string",
      "description": "Optional serial number (anonymized if public)."
    },
    "year": {
      "type": "integer",
      "minimum": 1980,
      "maximum": 2026,
      "description": "Manufacturing year."
    },
    "inputPower": {
      "type": "object",
      "properties": {
        "voltage": { "type": "string", "description": "e.g., 220V, 380V" },
        "phase": { "type": "string", "enum": ["single", "three"] },
        "frequency": {
          "type": "integer",
          "description": "Hz, typically 50 or 60"
        }
      }
    },
    "outputRange": {
      "type": "object",
      "properties": {
        "minAmps": { "type": "number" },
        "maxAmps": { "type": "number" },
        "dutyCycle": { "type": "string", "description": "e.g., 60% @ 200A" }
      }
    },
    "accessories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "e.g., electrode holder, torch, foot pedal"
          },
          "condition": {
            "type": "string",
            "enum": ["excellent", "good", "fair", "worn", "damaged"]
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Free-text observations about this equipment."
    }
  }
}
