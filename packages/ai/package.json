  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "ai": "^6.0.206",
    "@drenyra/application": "workspace:*",
    "@drenyra/infrastructure": "workspace:*",
    "@drenyra/persistence": "workspace:*",
    "@drenyra/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
