{
  "name": "@drenyra/ai",
  "version": "0.1.0",
  "description": "AI facade package for Drenyra",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./control-plane": "./src/control-plane/index.ts",
    "./gateway": "./src/gateway/index.ts",
    "./model-registry": "./src/ai/model-registry.ts",
    "./openrouter": "./src/ai/openrouter/index.ts",
    "./provider": "./src/provider.ts",
    "./providers/model-router-types": "./src/providers/model-router-types.ts",
    "./sunat-corpus": "./src/sunat-corpus.ts",
    "./tool-bridge": "./src/ai/tool-bridge.ts",
    "./rag/types": "./src/ai/rag/types.ts",
    "./services/ai-cost": "./src/services/ai-cost.ts",
    "./services/ai-latency": "./src/services/ai-latency.ts",
    "./services/error-recovery": "./src/services/error-recovery/index.ts",
    "./services/sunat-knowledge": "./src/services/sunat-knowledge.ts",
    "./services/swarm-consensus": "./src/services/swarm-consensus.ts",
    "./services/swarm-consensus/consensus-engine": "./src/services/swarm-consensus-engine.ts",
    "./services/swarm-consensus/types": "./src/services/swarm-consensus-types.ts",
    "./agents": "./src/agents/index.ts",
    "./batch": "./src/agents/orchestrator/batch/index.ts",
    "./context-monitor": "./src/context-monitor/index.ts",
    "./governance": "./src/governance/index.ts",
    "./memory": "./src/memory/index.ts",
    "./orchestrator": "./src/agents/orchestrator/workflow-v2/types.ts",
    "./session": "./src/session/index.ts",
    "./tools/ai-sdk": "./src/ai/tools/index.ts",
    "./agents/tool-loop": "./src/ai/agents/tool-loop-agent.ts",
    "./agents/judgment-day": "./src/agents/judgment-day/index.ts",
    "./streaming/agent-ui": "./src/ai/streaming/agent-ui-stream.ts"
