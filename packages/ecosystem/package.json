{
  "name": "@arkelythex/ecosystem",
  "version": "0.1.0",
  "description": "Drenyra Ecosystem Integration — connectors for open source tools (ERPNext, DuckDB, Docling, N8N, Dify, Temporal, Neo4j, Metabase, MinIO)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./connector.port": "./src/connector.port.ts",
    "./connector.registry": "./src/connector.registry.ts",
    "./base.connector": "./src/base.connector.ts",
    "./health": "./src/health.ts",
    "./adapters/erpnext": "./src/adapters/erpnext/index.ts",
    "./adapters/duckdb": "./src/adapters/duckdb/index.ts",
    "./adapters/docling": "./src/adapters/docling/index.ts",
    "./adapters/dify": "./src/adapters/dify/index.ts"
  },
  "scripts": {
    "typecheck": "cd ../.. && bun run typecheck --filter @arkelythex/ecosystem",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@arkelythex/shared": "workspace:*",
    "@arkelythex/infrastructure": "workspace:*",
    "zod": "^4.4.3"
  }
}
