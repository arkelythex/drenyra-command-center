{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "../..",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/index.ts",
    "src/actions/**/*.ts",
    "src/adapters/**/*.ts",
    "src/agents/**/*.ts",
    "src/ai/accounting-classifier.service.ts",
    "src/ai/ai-provider.factory.ts",
    "src/ai/model-registry.ts",
    "src/ai/models.ts",
    "src/ai/ocr.service.ts",
    "src/ai/ocr/**/*.ts",
    "src/ai/openrouter/index.ts",
    "src/ai/prompts.ts",
    "src/ai/router.ts",
    "src/ai/schemas/**/*.ts",
    "src/ai/tool-bridge.ts",
    "src/ai/validation.service.ts",
    "src/db/client.ts",
    "src/db/query.ts",
    "src/db/schema/**/*.ts",
    "src/db/seed.ts",
    "src/events/event.port.ts",
    "src/events/nats.adapter.ts",
    "src/logger.ts",
    "src/queues/document-processor.queue.ts",
    "src/queues/document-processor.worker.ts",
    "src/queues/redis.ts",
    "src/repositories/chat.repository.ts",
    "src/security/security-service.ts",
    "src/services/ai-cost/**/*.ts",
    "src/services/error-recovery/**/*.ts",
    "src/services/python-ocr/**/*.ts",
    "src/services/sunat-knowledge.ts",
    "src/services/swarm-consensus/**/*.ts",
    "src/tax-authority/**/*.ts",
    "src/xml/**/*.ts",
    "../domain/src/services/pcge-catalog.ts",
    "src/xsd/**/*.ts"
  ],
  "exclude": ["dist", "**/dist/**", "**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"]
}
