#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Drenyra — Pre-commit Hook
# Advisory review-readability check on staged changes.
# Does NOT block the commit — only warns.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HOOK_NAME="pre-commit"
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${CYAN}━━━ Drenyra Pre-Commit Hook ━━━${NC}"

# ── 1. Check staged files for hot paths ─────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
	echo -e "${YELLOW}⚠  No staged files to check.${NC}"
	exit 0
fi

HOT_PATTERNS="auth/ security/ fiscal/ sunat/ payments/ compliance/"
HOT_FILES=""

for pattern in $HOT_PATTERNS; do
	matches=$(echo "$STAGED_FILES" | grep -i "$pattern" || true)
	if [ -n "$matches" ]; then
		HOT_FILES="$HOT_FILES $matches"
	fi
done

if [ -n "$HOT_FILES" ]; then
	echo -e "${YELLOW}⚠  Hot path files staged:${NC}"
	echo "$HOT_FILES" | tr ' ' '\n' | head -10
	echo ""
fi

# ── 2. Check for console.log in staged files ────────────────────────────────
CONSOLE_LOG_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | xargs -I{} sh -c '
	if git show ":$1" | grep -n "console\.log" | grep -v "//.*console\.log" > /dev/null 2>&1; then
		echo "$1"
	fi
' _ {} 2>/dev/null || true)

if [ -n "$CONSOLE_LOG_FILES" ]; then
	echo -e "${YELLOW}⚠  Suspicious console.log found in:${NC}"
	echo "$CONSOLE_LOG_FILES" | tr ' ' '\n'
	echo ""
fi

# ── 3. Check for TODO without issue number ──────────────────────────────────
TODO_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|go|py)$' | xargs -I{} sh -c '
	if git show ":$1" | grep -E "TODO|FIXME" | grep -vE "TODO\(#[0-9]+\)|FIXME\(#[0-9]+\)" > /dev/null 2>&1; then
		echo "$1"
	fi
' _ {} 2>/dev/null || true)

if [ -n "$TODO_FILES" ]; then
	echo -e "${YELLOW}⚠  Files with TODO/FIXME missing issue reference:${NC}"
	echo "$TODO_FILES" | tr ' ' '\n'
	echo ""
fi

# ── 4. Count changed lines ──────────────────────────────────────────────────
ADDED_LINES=$(git diff --cached --numstat 2>/dev/null | awk '{s+=$1} END {print s}')
DELETED_LINES=$(git diff --cached --numstat 2>/dev/null | awk '{s+=$2} END {print s}')
TOTAL=$((ADDED_LINES + DELETED_LINES))

echo -e "${CYAN}📊  Staged: ${ADDED_LINES:-0}+ / ${DELETED_LINES:-0}- (${TOTAL:-0} total lines)${NC}"

if [ "${TOTAL:-0}" -gt 400 ]; then
	echo -e "${YELLOW}⚠  Large staged change (${TOTAL} lines). Consider splitting into smaller commits.${NC}"
	echo -e "${YELLOW}   See .agent/skills/chained-pr/SKILL.md for guidance.${NC}"
fi

# ── 5. Check typecheck on staged files (quick only) ─────────────────────────
if command -v bun &> /dev/null && [ -f "bun.lock" ] || [ -f "package.json" ]; then
	if echo "$STAGED_FILES" | grep -qE '\.(ts|tsx)$'; then
		echo -e "${CYAN}🔍  TypeScript files detected — run 'bun run typecheck' before pushing.${NC}"
	fi
fi

echo -e "${CYAN}━━━ Pre-commit review complete (advisory — commit not blocked) ━━━${NC}"
exit 0
