{
  "name": "@drenyra/api",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build:binary": "bash ../../scripts/build-api-binary.sh",
    "deploy:fly": "bash ../../scripts/deploy/deploy-api-fly.sh",
    "test": "vitest",
    "test:db": "bun ./scripts/run-db-tests.mjs",
    "test:db:compliance": "bun ./scripts/run-db-tests.mjs src/services/__tests__/integration/compliance-reproducibility.integration.test.ts",
    "test:db:taxation": "bun ./scripts/run-db-tests.mjs src/features/taxation/__tests__/integration/retenciones.integration.test.ts",
    "validate:taxation:retentions": "bun ./scripts/validate-taxation-retentions.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "typecheck": "tsc -p ../../tsconfig.check.json",
    "test:sandbox:prometeo": "RUN_PROMETEO_SANDBOX_TESTS=1 vitest run src/features/banking-providers/__tests__/e2e/prometeo-sandbox-smoke.test.ts",
    "test:contracts": "vitest run src/shared/clients/__tests__/data-engine-contract.test.ts",
    "db:push": "cd ../../packages/infrastructure && bun run db:push",
    "db:studio": "cd ../../packages/infrastructure && bun run db:studio",
    "db:generate": "cd ../../packages/infrastructure && bun run db:generate",
    "db:seed": "cd ../.. && bash ./scripts/dev/seed-dev-bootstrap.sh",
    "sire:demo:verify": "bun ./scripts/verify-sire-demo-export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@mastra/core": "^1.4.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@supabase/supabase-js": "^2.106.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.9.10",
    "ai": "^7.0.15",
    "archiver": "^8.0.0",
    "better-auth": "^1.6.16",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.29",
    "elysia-helmet": "^3.0.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.3.3",
    "nanoid": "^6.0.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "prom-client": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "ulid": "^3.0.2",
    "xml-crypto": "^6.0.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.3.5",
    "@drenyra/ai": "workspace:*",
    "@drenyra/application": "workspace:*",
    "@drenyra/domain": "workspace:*",
    "@drenyra/infrastructure": "workspace:*",
    "@drenyra/pi": "workspace:*",
    "@drenyra/shared": "workspace:*",
    "@drenyra/security": "workspace:*"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/xml-crypto": "^1.4.6",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
