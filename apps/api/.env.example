# =============================================================================
# ARKELYTHEX API (@arkelythex/api)
# =============================================================================
# SHARED env vars live in .env.example at repo root.
# This file documents ONLY API-specific vars.
#
# See repo root .env.example for: DATABASE_URL, REDIS_URL, SMTP_*, AI_KEY_*,
# BETTER_AUTH_*, CORS_ALLOWED_ORIGINS, STORAGE_PROVIDER/R2_*, SENTRY_DSN,
# FRONTEND_TELEMETRY_*, LOG_LEVEL, SIRE_JWT_SECRET, etc.
# =============================================================================

# ── OSE / CPE Electronic Invoicing ──────────────────────────────────────────
OSE_PROVIDER=nubefact                    # nubefact | bizlinks | custom | simulation
OSE_ENV=sandbox                          # sandbox | production
OSE_API_URL=https://api.nubefact.com/api/v1
OSE_API_TOKEN=
OSE_USERNAME=
COMPANY_RUC=20123456789
OSE_SIMULATION_MODE=false
OSE_WEBHOOK_SECRET=

# ── Prometeo Banking API ────────────────────────────────────────────────────
PROMETEO_API_KEY=
PROMETEO_ENV=sandbox

# ── CPE Validator ───────────────────────────────────────────────────────────
SUNAT_CPE_REPLAY_FIXTURE_PATH=apps/api/src/features/cpe-validator/fixtures/sunat-cpe-replay.json

# ── Better Auth Trusted Origins (API-specific) ──────────────────────────────
# Local defaults already include: localhost:3000, localhost:5173, 127.0.0.1:5173
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.18.4:5173,http://10.0.0.20:4173

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Never commit .env files to git
# 2. Use strong random values for secrets in production
# 3. LEDGER_MVP_* vars belong in root .env.example (repo root)
