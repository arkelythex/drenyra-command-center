{
  "name": "@drenyra/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.check.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "check:bundle": "bun ./scripts/check-bundle-budget.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "quality": "bun run test:run && bun run build && bun run check:bundle",
    "quality:strict": "bun run lint && bun run check:classnames && bun run quality",
    "check:classnames": "bun ./scripts/check-classname-template-literals.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@elysiajs/eden": "^1.4.6",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/react": "^10.57.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.103.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@tanstack/router-plugin": "^1.150.0",
    "@xstate/react": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "^1.6.16",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "framer-motion": "^12.27.3",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "1.25.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^17.0.8",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "xstate": "^5.28.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10",
    "@drenyra/api": "workspace:*",
    "@drenyra/application": "workspace:*",
    "@drenyra/domain": "workspace:*",
    "@drenyra/pi": "workspace:*",
    "@drenyra/shared": "workspace:*",
    "@drenyra/ui": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "clsx": "^2.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^30.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "4.1.10"
  }
}
