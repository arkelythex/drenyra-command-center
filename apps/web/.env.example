# =============================================================================
# @arkelythex/web — Frontend env vars
# =============================================================================
# SHARED env vars live in .env.example at repo root.
# This file documents ONLY VITE_-prefixed frontend vars.
#
# See repo root .env.example for: VITE_BETTER_AUTH_URL, VITE_API_URL,
# VITE_API_PROXY_TARGET, VITE_MONITORING_*, VITE_SENTRY_*, VITE_PLAUSIBLE_*
# =============================================================================

VITE_BETTER_AUTH_URL=http://localhost:5173
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_ENABLE_DEMO_AUTH=false
VITE_HTTP_TIMEOUT_MS=10000
VITE_FRONTEND_MOCK_MODE=false
VITE_MONITORING_ENABLED=true
VITE_MONITORING_ENDPOINT=
VITE_MONITORING_KEY=
VITE_WEB_VITALS_ENABLED=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_SCRIPT_URL=https://browser.sentry-cdn.com/8.33.0/bundle.tracing.replay.min.js
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_API_HOST=https://plausible.io
VITE_ENABLE_VOICE_NAVIGATION=true

# ⚠️ VITE_ prefixed vars are exposed to ALL frontend users via the JS bundle.
# NEVER put API keys, secrets, or tokens here.
