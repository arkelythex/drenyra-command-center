{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["vite/client", "react", "react-dom"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/context/*": ["./src/context/*"],
      "@/store/*": ["./src/store/*"],
      "@drenyra/api/contract": ["../../apps/api/src/contract.ts"],

      "@drenyra/ai": ["../../packages/ai/src/index.ts"],
      "@drenyra/ai/*": ["../../packages/ai/src/*"],
      "@drenyra/application": ["../../packages/application/src/index.ts"],
      "@drenyra/application/*": ["../../packages/application/src/*"],
      "@drenyra/domain": ["../../packages/domain/src/index.ts"],
      "@drenyra/domain/*": ["../../packages/domain/src/*"],
      "@drenyra/infrastructure": ["../../packages/infrastructure/src/index.ts"],
      "@drenyra/infrastructure/*": ["../../packages/infrastructure/src/*"],
      "@drenyra/shared": ["../../packages/shared/src/index.ts"],
      "@drenyra/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "src/vite-env.d.ts"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "src/**/*.stories.tsx"
  ]
}
