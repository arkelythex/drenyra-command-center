{
  "$deprecated": true,
  "$deprecationNote": "DEPRECATED — Use tokens.dtcg.json (W3C DTCG format) as source of truth. Run: bun tokens:generate",
  "$replacedBy": "tokens.dtcg.json",
  "color": {
    "bg": {
      "0": "#090B0F",
      "1": "#10141A",
      "2": "#171C24"
    },
    "surface": {
      "1": "#1D232D",
      "2": "#252D38",
      "3": "#2E3745"
    },
    "stroke": {
      "1": "#3A4352",
      "2": "#4B5567",
      "3": "#5F6B80"
    },
    "text": {
      "primary": "#F5F7FB",
      "secondary": "#C0C7D3",
      "muted": "#919BAA",
      "disabled": "#6F7886",
      "inverse": "#0B0D11"
    },
    "accent": {
      "green": {
        "base": "#BFC9D6",
        "hover": "#D2D8E0",
        "active": "#A7B2C0"
      },
      "blue": {
        "base": "#AAB4C1",
        "hover": "#C2CAD4",
        "active": "#949FAC"
      },
      "steel": {
        "base": "#C4CBD6",
        "hover": "#D8DDE5",
        "active": "#ABB4C2"
      }
    },
    "state": {
      "success": "#7FB49A",
      "warning": "#C6AB7E",
      "danger": "#BF8C8C",
      "info": "#BEC6D2"
    },
    "ai": {
      "haloCyan": "rgba(188, 198, 210, 0.16)",
      "haloSteel": "rgba(160, 170, 184, 0.15)"
    }
  },
  "font": {
    "family": {
      "ui": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial",
      "mono": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "size": {
      "xs": 12,
      "sm": 13,
      "md": 15,
      "lg": 17,
      "xl": 20,
      "2xl": 24,
      "3xl": 30
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "tight": -0.02,
      "normal": 0,
      "wide": 0.02
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 32,
    "8": 40,
    "9": 48,
    "10": 64
  },
  "layout": {
    "containerMax": 1200,
    "gutter": 24,
    "sidebar": {
      "min": 280,
      "max": 360
    },
    "panelGap": 16
  },
  "radius": {
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 24,
    "pill": 999
  },
  "border": {
    "thin": 1,
    "thick": 2
  },
  "shadow": {
    "1": "0 1px 0 rgba(255,255,255,0.03), 0 8px 24px rgba(0,0,0,0.35)",
    "2": "0 1px 0 rgba(255,255,255,0.04), 0 18px 48px rgba(0,0,0,0.45)"
  },
  "motion": {
    "duration": {
      "fast": 120,
      "normal": 180,
      "slow": 260
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.7, 0, 0.84, 0)"
    }
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "dropdown": 30,
    "overlay": 50,
    "modal": 70,
    "toast": 90,
    "debug": 110
  },
  "button": {
    "height": {
      "sm": 36,
      "md": 44,
      "lg": 52
    },
    "radius": "md",
    "paddingX": {
      "sm": 12,
      "md": 16,
      "lg": 18
    },
    "primary": {
      "bg": "{color.accent.blue.base}",
      "fg": "{color.text.primary}"
    },
    "secondary": {
      "bg": "{color.surface.2}",
      "fg": "{color.text.primary}",
      "stroke": "{color.stroke.2}"
    },
    "ghost": {
      "bg": "transparent",
      "fg": "{color.text.secondary}"
    }
  },
  "composer": {
    "minHeight": 48,
    "radius": "xl",
    "bg": "{color.surface.2}",
    "stroke": "{color.stroke.2}",
    "focusRing": "0 0 0 4px rgba(190,198,210,0.24)"
  },
  "panel": {
    "radius": "lg",
    "bg": "{color.surface.2}",
    "stroke": "{color.stroke.1}",
    "shadow": "{shadow.1}",
    "headerHeight": 44
  },
  "chip": {
    "radius": "pill",
    "bg": "{color.surface.3}",
    "stroke": "{color.stroke.1}",
    "text": "{color.text.secondary}",
    "success": {
      "bg": "rgba(127,180,154,0.14)",
      "text": "#7FB49A"
    },
    "warning": {
      "bg": "rgba(198,171,126,0.14)",
      "text": "#C6AB7E"
    },
    "danger": {
      "bg": "rgba(191,140,140,0.14)",
      "text": "#BF8C8C"
    },
    "info": {
      "bg": "rgba(190,198,210,0.14)",
      "text": "#BEC6D2"
    }
  }
}
