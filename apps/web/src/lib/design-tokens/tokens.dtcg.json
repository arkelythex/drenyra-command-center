{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "name": "Drenyra Fiscal Editorial Tokens",
    "version": "3.0.0",
    "description": "W3C DTCG — Fiscal Editorial rebrand (Cursor-inspired editorial + fiscal compliance)",
    "palette": "Fiscal Editorial — espresso canvas, voltage accent",
    "generator": "scripts/generate-tokens.ts",
    "updatedAt": "2026-06-30"
  },

  "primitive": {
    "$description": "Tier 1: Raw values. Prefer semantic tokens in components.",

    "espresso-0": {
      "$type": "color",
      "$value": "#161614",
      "$description": "Dark canvas (Fiscal Editorial)"
    },
    "espresso-1": {
      "$type": "color",
      "$value": "#1c1c1a",
      "$description": "Raised dark background"
    },
    "espresso-2": { "$type": "color", "$value": "#242422", "$description": "Card surface dark" },
    "espresso-3": { "$type": "color", "$value": "#2e2e2b", "$description": "Elevated hover dark" },

    "onyx-0": {
      "$type": "color",
      "$value": "{primitive.espresso-0}",
      "$description": "Legacy alias"
    },
    "onyx-1": {
      "$type": "color",
      "$value": "{primitive.espresso-1}",
      "$description": "Legacy alias"
    },
    "onyx-2": {
      "$type": "color",
      "$value": "{primitive.espresso-2}",
      "$description": "Legacy alias"
    },
    "onyx-3": {
      "$type": "color",
      "$value": "{primitive.espresso-3}",
      "$description": "Legacy alias"
    },

    "black-0": { "$type": "color", "$value": "{primitive.espresso-0}" },
    "black-1": { "$type": "color", "$value": "{primitive.espresso-1}" },
    "black-2": { "$type": "color", "$value": "{primitive.espresso-2}" },

    "cream-0": { "$type": "color", "$value": "#f7f7f4", "$description": "Light editorial canvas" },
    "cream-1": { "$type": "color", "$value": "#efeee8", "$description": "Light raised surface" },

    "surface-1": { "$type": "color", "$value": "#242422" },
    "surface-2": { "$type": "color", "$value": "#2e2e2b" },
    "surface-3": { "$type": "color", "$value": "#3a3a36" },

    "stroke-1": { "$type": "color", "$value": "#333330", "$description": "Hairline border dark" },
    "stroke-2": { "$type": "color", "$value": "#3d3d39", "$description": "Default border dark" },
    "stroke-3": { "$type": "color", "$value": "#52524e", "$description": "Prominent border dark" },

    "white": { "$type": "color", "$value": "#e8e6e0", "$description": "Primary ink on dark" },
    "gray-300": { "$type": "color", "$value": "#c9c7c0" },
    "gray-400": { "$type": "color", "$value": "#9a9890", "$description": "Secondary text dark" },
    "gray-600": { "$type": "color", "$value": "#6f6d66", "$description": "Muted text dark" },
    "gray-700": { "$type": "color", "$value": "#54524c", "$description": "Disabled text dark" },

    "voltage-400": { "$type": "color", "$value": "#ff6a1a", "$description": "Voltage hover" },
    "voltage-500": {
      "$type": "color",
      "$value": "#f54e00",
      "$description": "Primary voltage accent (Cursor-adapted)"
    },
    "voltage-600": { "$type": "color", "$value": "#d94400", "$description": "Voltage active" },

    "fiscal-500": {
      "$type": "color",
      "$value": "#c45c2a",
      "$description": "SUNAT/compliance secondary accent"
    },

    "blue-200": {
      "$type": "color",
      "$value": "{primitive.voltage-400}",
      "$description": "Legacy alias → voltage"
    },
    "blue-300": {
      "$type": "color",
      "$value": "#ffb899",
      "$description": "Agent timeline pastel peach"
    },
    "blue-400": { "$type": "color", "$value": "{primitive.voltage-400}" },
    "blue-500": {
      "$type": "color",
      "$value": "{primitive.voltage-500}",
      "$description": "Legacy alias → voltage"
    },
    "blue-600": { "$type": "color", "$value": "{primitive.voltage-600}" },

    "green-400": { "$type": "color", "$value": "oklch(0.75 0.20 150)" },
    "green-500": { "$type": "color", "$value": "oklch(0.65 0.22 150)" },
    "green-600": { "$type": "color", "$value": "oklch(0.55 0.22 150)" },

    "amber-400": { "$type": "color", "$value": "oklch(0.85 0.20 80)" },
    "amber-500": { "$type": "color", "$value": "oklch(0.75 0.22 80)" },
    "red-400": { "$type": "color", "$value": "oklch(0.65 0.25 25)" },
    "red-500": { "$type": "color", "$value": "oklch(0.55 0.25 25)" }
  },

  "semantic": {
    "bg": {
      "base": { "$type": "color", "$value": "{primitive.espresso-0}" },
      "raised": { "$type": "color", "$value": "{primitive.espresso-1}" },
      "elevated": { "$type": "color", "$value": "{primitive.espresso-2}" }
    },
    "surface": {
      "1": { "$type": "color", "$value": "{primitive.surface-1}" },
      "2": { "$type": "color", "$value": "{primitive.surface-2}" },
      "3": { "$type": "color", "$value": "{primitive.surface-3}" }
    },
    "stroke": {
      "1": { "$type": "color", "$value": "{primitive.stroke-1}" },
      "2": { "$type": "color", "$value": "{primitive.stroke-2}" },
      "3": { "$type": "color", "$value": "{primitive.stroke-3}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.white}" },
      "secondary": { "$type": "color", "$value": "{primitive.gray-400}" },
      "muted": { "$type": "color", "$value": "{primitive.gray-600}" },
      "disabled": { "$type": "color", "$value": "{primitive.gray-700}" },
      "inverse": {
        "$type": "color",
        "$value": "#26251e",
        "$description": "Espresso ink on light canvas"
      }
    },
    "accent": {
      "voltage": {
        "light": { "$type": "color", "$value": "{primitive.voltage-400}" },
        "base": { "$type": "color", "$value": "{primitive.voltage-500}" },
        "hover": { "$type": "color", "$value": "{primitive.voltage-400}" },
        "active": { "$type": "color", "$value": "{primitive.voltage-600}" }
      },
      "fiscal": {
        "base": { "$type": "color", "$value": "{primitive.fiscal-500}" }
      },
      "blue": {
        "light": { "$type": "color", "$value": "{semantic.accent.voltage.hover}" },
        "base": { "$type": "color", "$value": "{semantic.accent.voltage.base}" },
        "hover": { "$type": "color", "$value": "{semantic.accent.voltage.hover}" },
        "active": { "$type": "color", "$value": "{semantic.accent.voltage.active}" }
      },
      "green": {
        "base": { "$type": "color", "$value": "{primitive.green-500}" },
        "hover": { "$type": "color", "$value": "{primitive.green-400}" },
        "active": { "$type": "color", "$value": "{primitive.green-600}" }
      },
      "gold": {
        "base": { "$type": "color", "$value": "{primitive.amber-500}" },
        "light": { "$type": "color", "$value": "{primitive.amber-400}" }
      }
    },
    "state": {
      "success": { "$type": "color", "$value": "{primitive.green-500}" },
      "warning": { "$type": "color", "$value": "{primitive.amber-500}" },
      "danger": { "$type": "color", "$value": "{primitive.red-500}" },
      "info": { "$type": "color", "$value": "{primitive.fiscal-500}" }
    },
    "ai": {
      "primary": { "$type": "color", "$value": "{primitive.voltage-400}" },
      "secondary": { "$type": "color", "$value": "{primitive.voltage-600}" },
      "halo": { "$type": "color", "$value": "color-mix(in oklch, #f54e00 18%, transparent)" },
      "haloCyan": { "$type": "color", "$value": "color-mix(in oklch, #7eb8ff 16%, transparent)" },
      "haloSteel": { "$type": "color", "$value": "color-mix(in oklch, #b8a8ff 14%, transparent)" }
    }
  },

  "component": {
    "score-ring": {
      "from": { "$type": "color", "$value": "{primitive.amber-400}" },
      "mid": { "$type": "color", "$value": "{primitive.fiscal-500}" },
      "to": { "$type": "color", "$value": "{primitive.voltage-500}" }
    },
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{semantic.accent.voltage.base}" },
        "fg": { "$type": "color", "$value": "#ffffff" },
        "border": { "$type": "color", "$value": "{semantic.accent.voltage.active}" }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{semantic.surface.2}" },
        "fg": { "$type": "color", "$value": "{semantic.text.primary}" },
        "border": { "$type": "color", "$value": "{semantic.stroke.2}" }
      }
    },
    "chip": {
      "success": {
        "$type": "color",
        "$value": "color-mix(in oklch, oklch(0.65 0.22 150) 14%, transparent)"
      },
      "warning": {
        "$type": "color",
        "$value": "color-mix(in oklch, oklch(0.75 0.22 80) 14%, transparent)"
      },
      "danger": {
        "$type": "color",
        "$value": "color-mix(in oklch, oklch(0.55 0.25 25) 14%, transparent)"
      },
      "info": { "$type": "color", "$value": "color-mix(in oklch, #c45c2a 14%, transparent)" }
    },
    "editorial": {
      "surface": { "$type": "color", "$value": "{semantic.surface.1}" },
      "border": { "$type": "color", "$value": "{semantic.stroke.1}" },
      "highlight": { "$type": "color", "$value": "color-mix(in oklch, white 3%, transparent)" }
    }
  }
}
