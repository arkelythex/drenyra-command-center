{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "name": "Drenyra Cyan/Violet Tokens",
    "version": "4.0.0",
    "description": "W3C DTCG — Cyan/Violet rebrand (APCA-aware palette, fiscal semantics)",
    "palette": "Cyan/Violet APCA-aware",
    "generator": "scripts/generate-tokens.ts",
    "updatedAt": "2026-07-05"
  },

  "primitive": {
    "$description": "Tier 1: Raw values. Prefer semantic tokens in components.",

    "canvas-dark": { "$type": "color", "$value": "#0B0E11", "$description": "Dark canvas root" },
    "surface-dark": { "$type": "color", "$value": "#12161B", "$description": "Dark panel surface" },
    "surface-2-dark": {
      "$type": "color",
      "$value": "#1A1F26",
      "$description": "Dark elevated panel"
    },
    "overlay-dark": { "$type": "color", "$value": "#20262E", "$description": "Dark modal/popover" },

    "canvas-light": { "$type": "color", "$value": "#FAFAF9", "$description": "Light canvas root" },
    "surface-light": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Light panel surface"
    },
    "surface-2-light": {
      "$type": "color",
      "$value": "#F2F2F0",
      "$description": "Light elevated panel"
    },
    "overlay-light": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Light modal/popover"
    },

    "border-subtle-dark": {
      "$type": "color",
      "$value": "#262C34",
      "$description": "Subtle border dark"
    },
    "border-default-dark": {
      "$type": "color",
      "$value": "#323A44",
      "$description": "Default border dark"
    },
    "border-subtle-light": {
      "$type": "color",
      "$value": "#E5E5E2",
      "$description": "Subtle border light"
    },
    "border-default-light": {
      "$type": "color",
      "$value": "#D4D4D0",
      "$description": "Default border light"
    },

    "text-primary-dark": {
      "$type": "color",
      "$value": "#EDEFF2",
      "$description": "Primary ink dark (APCA-safe)"
    },
    "text-secondary-dark": {
      "$type": "color",
      "$value": "#A8B0BC",
      "$description": "Secondary text dark"
    },
    "text-tertiary-dark": {
      "$type": "color",
      "$value": "#6B7480",
      "$description": "Tertiary text dark"
    },
    "text-disabled-dark": {
      "$type": "color",
      "$value": "#454C56",
      "$description": "Disabled text dark"
    },

    "text-primary-light": {
      "$type": "color",
      "$value": "#16181B",
      "$description": "Primary ink light (APCA-safe)"
    },
    "text-secondary-light": {
      "$type": "color",
      "$value": "#52565D",
      "$description": "Secondary text light"
    },
    "text-tertiary-light": {
      "$type": "color",
      "$value": "#7A7F87",
      "$description": "Tertiary text light"
    },
    "text-disabled-light": {
      "$type": "color",
      "$value": "#B0B4BA",
      "$description": "Disabled text light"
    },

    "cyan-500": { "$type": "color", "$value": "#3CE6D8", "$description": "Cyan accent base" },
    "cyan-400": { "$type": "color", "$value": "#6AEFE4", "$description": "Cyan accent hover" },
    "cyan-600": { "$type": "color", "$value": "#2ECFC2", "$description": "Cyan accent active" },
    "cyan-dim": {
      "$type": "color",
      "$value": "#1F8A80",
      "$description": "Cyan dim (small text on dark)"
    },

    "violet-500": { "$type": "color", "$value": "#9B7FE8", "$description": "Violet accent base" },
    "violet-400": { "$type": "color", "$value": "#B8A2F0", "$description": "Violet accent hover" },
    "violet-600": { "$type": "color", "$value": "#6B54A8", "$description": "Violet accent active" },
    "violet-dim": { "$type": "color", "$value": "#7B66C0", "$description": "Violet dim" },

    "state-success-dark": { "$type": "color", "$value": "#4ADE94", "$description": "Success dark" },
    "state-warning-dark": { "$type": "color", "$value": "#F5B84A", "$description": "Warning dark" },
    "state-error-dark": { "$type": "color", "$value": "#F0665E", "$description": "Error dark" },
    "state-pending-dark": { "$type": "color", "$value": "#6B9FE8", "$description": "Pending dark" },

    "state-success-light": {
      "$type": "color",
      "$value": "#1A8F52",
      "$description": "Success light"
    },
    "state-warning-light": {
      "$type": "color",
      "$value": "#A86A0A",
      "$description": "Warning light"
    },
    "state-error-light": { "$type": "color", "$value": "#C23B33", "$description": "Error light" },
    "state-pending-light": {
      "$type": "color",
      "$value": "#2E5FB8",
      "$description": "Pending light"
    }
  },

  "semantic": {
    "$description": "Tier 2: Semantic mappings. Use these in components.",

    "bg": {
      "dark": { "$type": "color", "$value": "{primitive.canvas-dark}" },
      "light": { "$type": "color", "$value": "{primitive.canvas-light}" }
    },
    "surface": {
      "1": { "$type": "color", "$value": "{primitive.surface-dark}" },
      "2": { "$type": "color", "$value": "{primitive.surface-2-dark}" },
      "3": { "$type": "color", "$value": "{primitive.overlay-dark}" }
    },
    "stroke": {
      "1": { "$type": "color", "$value": "{primitive.border-subtle-dark}" },
      "2": { "$type": "color", "$value": "{primitive.border-default-dark}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{primitive.text-primary-dark}" },
      "secondary": { "$type": "color", "$value": "{primitive.text-secondary-dark}" },
      "tertiary": { "$type": "color", "$value": "{primitive.text-tertiary-dark}" },
      "disabled": { "$type": "color", "$value": "{primitive.text-disabled-dark}" }
    },
    "accent": {
      "cyan": {
        "base": { "$type": "color", "$value": "{primitive.cyan-500}" },
        "hover": { "$type": "color", "$value": "{primitive.cyan-400}" },
        "active": { "$type": "color", "$value": "{primitive.cyan-600}" },
        "dim": { "$type": "color", "$value": "{primitive.cyan-dim}" }
      },
      "violet": {
        "base": { "$type": "color", "$value": "{primitive.violet-500}" },
        "hover": { "$type": "color", "$value": "{primitive.violet-400}" },
        "active": { "$type": "color", "$value": "{primitive.violet-600}" },
        "dim": { "$type": "color", "$value": "{primitive.violet-dim}" }
      }
    },
    "state": {
      "success": { "$type": "color", "$value": "{primitive.state-success-dark}" },
      "warning": { "$type": "color", "$value": "{primitive.state-warning-dark}" },
      "error": { "$type": "color", "$value": "{primitive.state-error-dark}" },
      "pending": { "$type": "color", "$value": "{primitive.state-pending-dark}" }
    },
    "ai": {
      "primary": { "$type": "color", "$value": "{primitive.cyan-500}" },
      "secondary": { "$type": "color", "$value": "{primitive.violet-500}" },
      "halo": { "$type": "color", "$value": "color-mix(in oklch, #3CE6D8 14%, transparent)" },
      "haloViolet": { "$type": "color", "$value": "color-mix(in oklch, #9B7FE8 14%, transparent)" }
    }
  },

  "component": {
    "$description": "Tier 3: Component-specific tokens.",

    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{semantic.accent.cyan.base}" },
        "fg": { "$type": "color", "$value": "#0A1A1A" },
        "border": { "$type": "color", "$value": "{semantic.accent.cyan.active}" }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{semantic.surface.2}" },
        "fg": { "$type": "color", "$value": "{semantic.text.primary}" },
        "border": { "$type": "color", "$value": "{semantic.stroke.2}" }
      }
    },
    "chip": {
      "success": { "$type": "color", "$value": "color-mix(in oklch, #4ADE94 14%, transparent)" },
      "warning": { "$type": "color", "$value": "color-mix(in oklch, #F5B84A 14%, transparent)" },
      "error": { "$type": "color", "$value": "color-mix(in oklch, #F0665E 14%, transparent)" },
      "pending": { "$type": "color", "$value": "color-mix(in oklch, #6B9FE8 14%, transparent)" },
      "info": { "$type": "color", "$value": "color-mix(in oklch, #9B7FE8 14%, transparent)" }
    },
    "editorial": {
      "surface": { "$type": "color", "$value": "{semantic.surface.1}" },
      "border": { "$type": "color", "$value": "{semantic.stroke.1}" },
      "highlight": { "$type": "color", "$value": "color-mix(in oklch, white 3%, transparent)" }
    }
  }
}
